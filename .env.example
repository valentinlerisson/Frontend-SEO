# Environment variables for Auditly

# Clé Google AI Studio (https://aistudio.google.com/apikey) pour l'analyse éditoriale IA.
# Sans clé, l'analyse retombe sur l'heuristique locale.
GEMINI_API_KEY=AAQ.Ab8RN6LZfiRk99gOPIO17wQeFYAgbdQYc5vNF0Dfka9H9-CUMw
# Optionnel : modèle Gemini (défaut gemini-3.8-flash)
# GEMINI_MODEL=gemini-3.8-flash

# Optionnel : modèles de repli si le principal est saturé (503) ou introuvable, séparés par des virgules
# GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.5-flash,gemini-3.1-flash-lite,gemini-2.5-flash-lite

# --- Endpoint compatible OpenAI (OmniRoute, OpenRouter, LiteLLM, Ollama, OpenAI…) ---
# Essayé en premier s'il est configuré ; Gemini sert de repli. Ordre modifiable : LLM_PROVIDERS=gemini,openai-compatible
# LLM_BASE_URL=http://localhost:20128/v1
# LLM_MODEL=nom-du-modele-ou-du-combo
# LLM_API_KEY=
# LLM_FALLBACK_MODELS=autre-modele,encore-un-autre
# LLM_MAX_TOKENS=8000
# LLM_MIN_INTERVAL_MS=0

# Clé gratuite de l'API Google PageSpeed Insights (Core Web Vitals) :
# https://console.cloud.google.com/ -> activer « PageSpeed Insights API » -> Identifiants -> Clé API.
# Sans clé, les Core Web Vitals restent non mesurés et sortent du score technique.
PAGESPEED_API_KEY=
# Nombre de pages mesurées par audit (accueil + pages les plus liées), 10 par défaut
# PSI_MAX_PAGES=10

# Positionnement Google (onglet « Positionnement ») : profil Chrome dédié, jamais connecté à un compte personnel
# SERP_PROFILE_DIR=./.serp-profile
# Pages de résultats lues par requête (10 résultats par page, 3 au plus), 1 par défaut
# SERP_PAGES=1
# Source des résultats : browser (défaut, Chrome local, contraire aux conditions de Google, usage personnel)
# ou serper (API Serper.dev payante, à utiliser si l'application est fournie à des tiers)
# SERP_PROVIDER=browser
# SERPER_API_KEY=
