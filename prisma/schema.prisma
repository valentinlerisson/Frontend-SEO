// Prisma Schema — SQLite pour le développement local autonome
// Pour basculer sur PostgreSQL en production, remplacer 'sqlite' par 'postgresql'
// et adapter les types de champs @map.

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

/// Recherches Google envoyées par jour, tous projets confondus (budget de la mesure Google)
model SerpUsage {
  /// Jour au format AAAA-MM-JJ (heure locale de la machine)
  day       String   @id
  searches  Int      @default(0)
  updatedAt DateTime @updatedAt

  @@map("serp_usage")
}

model Project {
  id          String   @id @default(cuid())
  domain      String   @unique
  name        String
  faviconUrl  String?
  /// Périmètre d'exploration choisi pour ce projet (JSON CrawlScope), repris à chaque relance
  crawlScope  String?
  /// Zones ciblées du projet (JSON GeoZone[], 3 au plus) : requêtes proposées et lieu simulé des mesures Google
  zonesRaw    String?
  /// Zone propre à certaines pages (JSON { [clé d'URL]: GeoZone }), gardée d'un audit à l'autre
  pageZonesRaw String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Cascade delete stricte : supprimer un projet supprime son audit et ses données
  audits      Audit[]
  fixTasks    FixTask[]

  @@map("projects")
}

/// Plan d'action : une correction à faire = une anomalie sur une page précise (ou sur tout le site), gardée d'un audit
/// à l'autre par le code de l'anomalie et la clé d'URL de la page
model FixTask {
  id             String    @id @default(cuid())
  projectId      String
  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  code           String    // code de l'anomalie (MISSING_H1…)
  pageKey        String    // SiteCrawler.urlKey de la page ; "" pour une anomalie du site entier
  url            String?   // adresse complète de la page, pour l'affichage
  title          String    // titre de l'anomalie sur cette page (dernier relevé)
  pillar         String    // TECH, EDITORIAL, GEO
  severity       String    // CRITICAL, WARNING, INFO (dernier relevé)
  recommendation String    @default("")

  status         String    @default("TODO") // TODO (à corriger), DOING (en cours), DONE (terminée), REMOVED (retirée du plan)
  position       Int       @default(0)      // ordre dans sa colonne
  source         String    @default("AUTO") // AUTO (impact fort ou moyen, ajoutée seule), MANUAL (ajoutée depuis Anomalies)
  note           String?

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  doneAt         DateTime?

  @@unique([projectId, code, pageKey])
  @@index([projectId, status])
  @@map("fix_tasks")
}

model Audit {
  id               String    @id @default(cuid())
  projectId        String
  project          Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  status           String    @default("IDLE") // IDLE, QUEUED, CRAWLING_TECH, AWAITING_AI_SELECTION, ANALYZING_AI, COMPLETED, FAILED
  progress         Int       @default(0) // 0 à 100%

  overallScore     Float?
  techScore        Float?
  editorialScore   Float?
  geoScore         Float?

  totalPagesCount  Int       @default(0)
  pillarPagesCount Int       @default(0)
  crawlStartedAt   DateTime?
  completedAt      DateTime?
  errorMessage     String?
  /// Backlinks relevés pendant le crawl (graphe Common Crawl + vérification), JSON BacklinkReport
  backlinksRaw     String?
  /// Périmètre d'exploration de cet audit (JSON CrawlScope)
  crawlScopeRaw    String?

  pages            Page[]
  issues           Issue[]

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@map("audits")
}

model Page {
  id              String   @id @default(cuid())
  auditId         String
  audit           Audit    @relation(fields: [auditId], references: [id], onDelete: Cascade)

  url             String
  path            String
  httpStatus      Int      @default(200)
  depth           Int      @default(0)
  isPillar        Boolean  @default(false)
  isIndexable     Boolean  @default(true)

  title           String?
  metaDescription String?
  h1              String?
  h2Count         Int      @default(0)
  wordCount       Int      @default(0)
  inlinksCount    Int      @default(0)
  outlinksCount   Int      @default(0)

  pageScore       Float?
  techScore       Float?
  editorialScore  Float?
  geoScore        Float?

  // Requête cible (module éditorial) : AUTO = déduite par l'IA, MANUAL = saisie utilisateur
  targetQuery       String?
  targetQuerySource String?  // AUTO | MANUAL
  // Hash du contenu crawlé, et hash (contenu + requête manuelle) de la dernière analyse IA
  contentHash       String?
  analyzedHash      String?

  metricsRaw      String?  // Stocké en JSON string pour compatibilité SQLite/Postgres
  aiEvaluationRaw String?  // Stocké en JSON string pour compatibilité SQLite/Postgres

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([auditId, url])
  @@index([auditId, isPillar])
  @@map("pages")
}

model Issue {
  id             String   @id @default(cuid())
  auditId        String
  audit          Audit    @relation(fields: [auditId], references: [id], onDelete: Cascade)

  pillar         String   // TECH, EDITORIAL, GEO
  severity       String   // CRITICAL, WARNING, INFO
  code           String
  title          String
  description    String
  recommendation String
  stepsToResolve String   // Stocké en JSON string (tableau de strings) pour SQLite

  affectedUrl    String?
  metadata       String?  // Stocké en JSON string

  createdAt      DateTime @default(now())

  @@index([auditId, pillar, severity])
  @@map("issues")
}
